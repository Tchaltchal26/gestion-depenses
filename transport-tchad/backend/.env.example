# Copier en .env et remplacer TOUTES les valeurs. Ne jamais versionner .env.
PORT=3000
DATABASE_URL=postgres://transport:transport@localhost:5433/transport
# 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_ENC_KEY=
PHONE_HASH_KEY=
JWT_SECRET=
SMS_WEBHOOK_SECRET=
# fake = SMS simulés (aucun SMS réel n'est envoyé). Seul fournisseur disponible pour l'instant.
SMS_PROVIDER=fake
# Intervalle du répartiteur (expiration des offres, vagues suivantes), en ms
DISPATCH_TICK_MS=2000
