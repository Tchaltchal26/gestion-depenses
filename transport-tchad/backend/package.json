{
  "name": "transport-tchad-backend",
  "version": "0.1.0",
  "description": "Backend de la plateforme de transport (pilote Abeche) - prototype phase 5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/dev/simulateur.html','dist/dev/simulateur.html')\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed-dev": "ts-node src/db/migrate.ts --seed-dev",
    "test": "jest --runInBand",
    "admin:create": "ts-node src/db/create-admin.ts",
    "init:env": "node scripts/init-env.js",
    "db:up": "docker compose up -d db"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
